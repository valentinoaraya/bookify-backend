{
  "name": "backend-bookify",
  "version": "1.0.0",
  "description": "",
  "main": "build/main.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/main.ts",
    "start": "node build/main.js",
    "worker": "ts-node-dev -r tsconfig-paths/register src/workers/reminderWorker.ts",
    "reset-queue": "ts-node -r tsconfig-paths/register src/queues/clearReminderQueue.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "migrate:slots": "ts-node -r tsconfig-paths/register src/migrations/001_migrate_slots.ts",
    "migrate:pending-reservations": "ts-node -r tsconfig-paths/register src/migrations/002_migrate_pending_reservations.ts",
    "migrate:payments": "ts-node -r tsconfig-paths/register src/migrations/003_migrate_payments.ts",
    "migrate:subscriptions": "ts-node -r tsconfig-paths/register src/migrations/004_migrate_subscriptions.ts",
    "migrate:unset-embedded": "ts-node -r tsconfig-paths/register src/migrations/005_unset_embedded_arrays.ts",
    "migrate:sync-indexes": "ts-node -r tsconfig-paths/register src/migrations/006_sync_indexes.ts",
    "migrate:pending-hold": "ts-node -r tsconfig-paths/register src/migrations/007_pending_reservations_hold.ts",
    "migrate:pending": "ts-node -r tsconfig-paths/register src/utils/migratePendingAppointments.ts",
    "migrate:mode": "ts-node -r tsconfig-paths/register src/utils/migrateModeOnline.ts",
    "migrate:serviceinfo": "ts-node -r tsconfig-paths/register src/utils/migrateServiceInfoNull.ts",
    "migrate:serviceactive": "ts-node -r tsconfig-paths/register src/utils/migrateActiveTrue.ts",
    "clone:dev-db": "ts-node -r tsconfig-paths/register src/scripts/cloneProdToDev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^16.4.5",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.7",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.3.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  }
}
